# Runtime mode. Use production only on the deployed API; local development must stay development.
NODE_ENV=development
DATABASE_URL=postgresql://tinykars:change-me@localhost:5432/tinykars
PORT=3001
PUBLIC_WEB_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
# Generate with: openssl rand -hex 32. Required in production and must stay stable.
OUTBOX_ENCRYPTION_KEY=
# Required in production. Verify the sending domain in Resend first.
RESEND_API_KEY=
EMAIL_FROM="Tiny Kars <accounts@example.com>"
# Only for a local test database; never enable on deployed services.
ALLOW_DEV_EMAIL_INSPECTION=0
# Optional until image upload is activated; configure all five together.
MEDIA_PUBLIC_BASE_URL=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Configure all three together in the host secret manager to enable checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Safe local/staging adapter. Never enable in production; it records an actual test order as paid
# without contacting Razorpay. Production startup rejects this flag.
PAYMENT_TEST_MODE=0
# Configure after Meta approves the order-confirmation template.
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_TEMPLATE_NAME=
META_WHATSAPP_TEMPLATE_LANGUAGE=en
META_GRAPH_API_VERSION=v24.0
# Generate a separate high-entropy secret for the client-owned Tally connector.
TALLY_CONNECTOR_SECRET=

# Set to 1 to let signed-out visitors browse products (the demo behaviour). Pending client decision.
PUBLIC_BROWSING=0

# Frontend build setting. Keep /api for same-origin local/reverse-proxy deployments, or set the
# public HTTPS API origin when the frontend and API are hosted separately.
VITE_API_BASE_URL=/api
