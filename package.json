{
  "name": "tiny-kars",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "dev:local": "node --import tsx scripts/dev-local.ts",
    "demo:client": "node --import tsx scripts/client-demo.ts",
    "dev:api": "node --env-file=.env --watch --import tsx server/index.ts",
    "start:api": "node --import tsx server/index.ts",
    "db:migrate": "node --env-file=.env --import tsx server/migrate.ts",
    "seed:samples": "node --env-file=.env --import tsx scripts/seed-samples.ts",
    "samples:images": "node --import tsx scripts/generate-sample-views.ts",
    "dev:email": "node --env-file=.env --import tsx server/dev-email.ts",
    "admin:provision": "node --env-file-if-exists=.env --import tsx server/identity/provision-admin.ts",
    "check:server": "tsc --noEmit -p tsconfig.server.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:integration:local": "node --import tsx scripts/test-pglite.ts",
    "verify:local-billing": "node --import tsx scripts/verify-local-billing.ts",
    "verify:local-customer": "node --import tsx scripts/verify-local-customer.ts",
    "verify:client-demo": "node --import tsx scripts/verify-client-demo.ts",
    "demo:record-billing": "node --import tsx scripts/record-billing-demo.ts",
    "verify:persistence": "node --import tsx scripts/verify-persistence-restart.ts",
    "test:e2e": "npm run test:production-ui",
    "test:production-ui": "playwright test -c playwright.production.config.ts",
    "lint": "eslint . --max-warnings=0",
    "check": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.9.2",
    "argon2": "^0.44.0",
    "bwip-js": "^4.11.4",
    "csv-parse": "^7.0.3",
    "fastify": "^5.12.7",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.3.0",
    "recharts": "^2.15.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.12",
    "@electric-sql/pglite-socket": "^0.2.15",
    "@eslint/js": "^10.0.1",
    "@fontsource/barlow-condensed": "^5.2.5",
    "@fontsource/dm-sans": "^5.2.5",
    "@playwright/test": "^1.51.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.2.0",
    "vitest": "^5.0.3"
  }
}
